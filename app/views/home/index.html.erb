<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PDF Fusion - Upload & Preview</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag 'application', media: 'all' %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #e3f2fd;
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    .navbar-container {
      background: white;
      padding: 10px 20px;
      border-radius: 12px;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
      margin: 10px auto;
      width: 95%;
      max-width: 1200px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .footer {
      background-color: #333;
      color: white;
      padding: 25px 0;
      text-align: center;
      margin-top: auto;
      width: 100%;
      margin-left: 0;
      margin-right: 0;
      border-radius: 0;
    }

    .navbar-brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .navbar-brand img {
      height: 50px;
      transition: transform 0.3s ease;
    }

    .navbar-brand:hover img {
      transform: scale(1.1);
    }

    .navbar-brand span {
      color: #125d98;
      font-size: 22px;
      font-weight: bold;
    }

    .nav-links {
      display: flex;
      gap: 20px;
    }

    .nav-links a {
      color: #125d98;
      font-size: 16px;
      font-weight: 500;
      text-decoration: none;
      padding: 8px 15px;
      border-radius: 5px;
      transition: background 0.3s;
    }

    .nav-links a:hover {
      background: #e3f2fd;
    }

    .container {
      background: white;
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      margin: 20px auto;
      width: 95%;
      max-width: 1200px;
      
      min-height: 73vh;
    }

    .card {
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      border: 2px solid #64b5f6;
      border-radius: 12px;
      height: 100%;
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 15px rgba(0, 0, 0, 0.15);
    }

    .upload-card {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
      background-color: #f8f9fa;
      border: 2px dashed #64b5f6;
      cursor: pointer;
    }

    .upload-card-content {
      text-align: center;
      color: #125d98;
    }

    .upload-icon {
      font-size: 3rem;
      margin-bottom: 1rem;
    }

    .card-img-top {
      height: 200px;
      object-fit: cover;
      border-top-left-radius: 12px;
      border-top-right-radius: 12px;
    }

    .card-body {
      padding: 20px;
    }

    .card-title {
      color: #125d98;
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }

    .card-text {
      color: #666;
      font-size: 0.9rem;
    }
  </style>
</head>
<body>
  <!-- Navbar -->
  <div class="navbar-container">
    <a class="navbar-brand" href="<%= root_path %>">
      <img src="<%= asset_path('pdf-fusion-logo.png') %>" alt="PDF Fusion Logo">
      <span>PDF Fusion</span>
    </a>
    <div class="nav-links">
      <a href="<%= root_path %>">Home</a>
      <a href="<%= about_path %>">About</a>
    </div>
  </div>

  <!-- Main Content -->
  <div class="container">
    <!-- PDF Templates Section -->
    <div class="mt-4">
      <h4 class="text-center">Select a Template</h4>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 justify-content-center">
        <!-- Upload Template Card -->
        <div class="col">
          <div class="card upload-card">
            <div class="upload-card-content">
              <div class="upload-icon">+</div>
              <h5>Upload Template</h5>
              <p class="text-muted small mb-0">(DOCX format only)</p>
            </div>
          </div>
        </div>


        <!-- Algoma Template -->
        <div class="col">
          <div class="card">
            <a href="<%= managefile_path(template: 'default') %>">
              <img src="<%= asset_path('template-1-thumbnail.png') %>" class="card-img-top" alt="Algoma Template">
            </a>
            <div class="card-body">
              <h5 class="card-title">Algoma University</h5>
              <p class="card-text">Student Contract</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="footer">
    <p>&copy; <%= Time.now.year %> PDF Fusion. All rights reserved.</p>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>